{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/health", "dest": "/api/health.js" },
    { "src": "/lista.m3u", "dest": "/api/lista.js" },
    { "src": "/deportes.m3u", "dest": "/api/deportes.js" },
    { "src": "/peru.m3u", "dest": "/api/peru.js" },
    { "src": "/pirlotv.m3u", "dest": "/api/pirlotv.js" },
    { "src": "/eventos.m3u", "dest": "/api/eventos.js" },
    { "src": "/live.m3u8", "dest": "/api/live.js" },
    { "src": "/stream.m3u8", "dest": "/api/stream.js" }
  ]
}
